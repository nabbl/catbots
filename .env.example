# Catfolio: Gemini/Argon decisions with the two-cat dashboard.
# The trainer is BENCHED in upstream mode, even if old coach flags remain set.
DECISION_PROVIDER=gemini
STRATEGY_ENGINE=upstream
GEMINI_API_KEY=

# Model, budget, pacing, capital, allocations and trading/risk limits use app defaults.
# See docs/UPSTREAM_ARGON_2026-10-21.md and src/config.ts for defaults/optional overrides.
# No key, exhausted budget or provider failure: CODE fallback can trade by fixed
# menu priorities. It does not read free-text rules; the dashboard labels it CODE.

# Keep paper mode. Compose enforces these values as well.
DRY_RUN=true
MODE=paper
# Preserve the existing example's local run path. Changing it selects another ledger.
DB_PATH=./data/catfolio-argon-{mode}.sqlite
SETTINGS_PATH=./data/catfolio-settings.json

# Optional owner key (24+ characters) for manual entry-limit reset/recovery.
# This does not enable the trainer. Never use your provider key here.
# COACH_ADMIN_TOKEN=

# Optional local Docker deployment overrides (defaults shown):
# DASHBOARD_PORT=8088
# DOCKER_DB_PATH=/data/catfolio-paper.sqlite
# Changing the database filename starts a separate run; preserve the old file.

# LM Studio, Jev and the old trainer are available with explicit legacy settings;
# see the README's legacy provider section. Their keys/knobs are unnecessary here.
# Copying this example does not clean an existing .env: remove old tuning/provider
# values there to use defaults. Local Compose still loads .env; Arcane uses its own
# minimal example in nabbl/gitops-arcane/catfolio-docktail.
